<?xml version="1.0" encoding="UTF-8" ?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!-- Cores principais do tema -->
    <Color x:Key="BackgroundDark">#0A0A0F</Color>
    <Color x:Key="NeonBlue">#00A8FF</Color>
    <Color x:Key="NeonPurple">#9D00FF</Color>
    <Color x:Key="TextPrimary">#FFFFFF</Color>
    <Color x:Key="TextSecondary">#BBBBBB</Color>

    <!-- Fonte grande e clara -->
    <Style TargetType="Label">
        <Setter Property="TextColor" Value="{StaticResource TextPrimary}" />
        <Setter Property="FontFamily" Value="Arial" />
    </Style>

    <!-- Tema dos Frames (cards) -->
    <Style TargetType="Frame">
        <Setter Property="CornerRadius" Value="20" />
        <Setter Property="HasShadow" Value="True" />
        <Setter Property="Shadow">
            <Setter.Value>
                <Shadow Brush="{StaticResource NeonBlue}"
                        Offset="0,5"
                        Radius="15"
                        Opacity="0.35"/>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Botões padrão (caso use depois) -->
    <Style TargetType="Button">
        <Setter Property="FontSize" Value="22"/>
        <Setter Property="TextColor" Value="White"/>
        <Setter Property="CornerRadius" Value="10"/>
        <Setter Property="Padding" Value="12,6"/>
        <Setter Property="BackgroundColor" Value="#1A1A1F"/>
    </Style>

</ResourceDictionary>