<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="TvBoxApp.SorteioPage"
             BackgroundColor="#121212">

    <Grid Padding="30"
          RowDefinitions="Auto,Auto,Auto,*,*"
          RowSpacing="20">

        <!-- VOLTAR -->
        <Button Text="⬅ Voltar"
                Clicked="OnVoltarClicked"
                HorizontalOptions="Start"
                Grid.Row="0"/>

        <!-- TÍTULO -->
        <Label Text="🎯 Sorteio da Família"
               FontSize="32"
               TextColor="White"
               HorizontalOptions="Center"
               Grid.Row="1"/>

        <!-- INPUT -->
        <HorizontalStackLayout Grid.Row="2" Spacing="10">
            <Entry x:Name="QuantidadePessoasEntry"
                   Placeholder="Qtd pessoas"
                   Keyboard="Numeric"
                   WidthRequest="200"
                   TextColor="White"
                   PlaceholderColor="Gray"/>

            <Button Text="Gerar"
                    Clicked="OnGerarCamposClicked"/>
        </HorizontalStackLayout>

        <!-- NOMES -->
        <ScrollView Grid.Row="3" HeightRequest="250">
            <VerticalStackLayout x:Name="NomesLayout" Spacing="10"/>
        </ScrollView>

        <!-- RESULTADO + HISTÓRICO -->
        <ScrollView Grid.Row="4">
            <VerticalStackLayout Spacing="20">

                <Button Text="🎲 Sortear"
                        Clicked="OnSortearClicked"/>

                <Label x:Name="AnimacaoLabel"
                       FontSize="22"
                       TextColor="Yellow"
                       HorizontalOptions="Center"/>

                <VerticalStackLayout x:Name="ResultadoLayout" Spacing="5"/>

                <Label Text="Histórico"
                       FontSize="20"
                       TextColor="White"/>

                <VerticalStackLayout x:Name="HistoricoLayout" Spacing="10"/>

            </VerticalStackLayout>
        </ScrollView>

    </Grid>
</ContentPage>