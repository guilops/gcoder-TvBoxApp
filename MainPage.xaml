<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="TvBoxApp.MainPage"
             BackgroundColor="#121212">

    <VerticalStackLayout Padding="40" Spacing="40">

        <Label Text="Apps de Streaming"
               FontSize="36"
               TextColor="White"
               HorizontalOptions="Center"/>

        <HorizontalStackLayout Spacing="35"
                               HorizontalOptions="Center">

            <!-- YOUTUBE -->
            <Border x:Name="CardYouTube"
                    WidthRequest="220"
                    HeightRequest="220"
                    StrokeShape="RoundRectangle 20"
                    BackgroundColor="#CC0000">

                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="TapYouTube"/>
                </Border.GestureRecognizers>

                <VerticalStackLayout VerticalOptions="Center"
                                     HorizontalOptions="Center">
                    <Image Source="youtube.png" WidthRequest="90"/>
                    <Label Text="YouTube" TextColor="White"/>
                </VerticalStackLayout>
            </Border>

            <!-- PRIME -->
            <Border x:Name="CardPrime"
                    WidthRequest="220"
                    HeightRequest="220"
                    StrokeShape="RoundRectangle 20"
                    BackgroundColor="#0053FF">

                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="TapPrime"/>
                </Border.GestureRecognizers>

                <VerticalStackLayout VerticalOptions="Center"
                                     HorizontalOptions="Center">
                    <Image Source="prime.png" WidthRequest="90"/>
                    <Label Text="Prime Video" TextColor="White"/>
                </VerticalStackLayout>
            </Border>

            <!-- NETFLIX -->
            <Border x:Name="CardNetflix"
                    WidthRequest="220"
                    HeightRequest="220"
                    StrokeShape="RoundRectangle 20"
                    BackgroundColor="#111111">

                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="TapNetflix"/>
                </Border.GestureRecognizers>

                <VerticalStackLayout VerticalOptions="Center"
                                     HorizontalOptions="Center">
                    <Image Source="netflix.png" WidthRequest="90"/>
                    <Label Text="Netflix" TextColor="Red"/>
                </VerticalStackLayout>
            </Border>

            <!-- DISNEY -->
            <Border x:Name="CardDisney"
                    WidthRequest="220"
                    HeightRequest="220"
                    StrokeShape="RoundRectangle 20"
                    BackgroundColor="#0A2342">

                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="TapDisney"/>
                </Border.GestureRecognizers>

                <VerticalStackLayout VerticalOptions="Center"
                                     HorizontalOptions="Center">
                    <Image Source="disney.png" WidthRequest="90"/>
                    <Label Text="Disney+" TextColor="White"/>
                </VerticalStackLayout>
            </Border>

            <!-- SORTEIO -->
            <Border x:Name="CardSorteio"
                    WidthRequest="220"
                    HeightRequest="220"
                    StrokeShape="RoundRectangle 20"
                    BackgroundColor="#00A8FF">

                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="TapSorteio"/>
                </Border.GestureRecognizers>

                <VerticalStackLayout VerticalOptions="Center"
                                     HorizontalOptions="Center">
                    <Label Text="🎲" FontSize="60"/>
                    <Label Text="Sorteio" TextColor="White"/>
                </VerticalStackLayout>
            </Border>

        </HorizontalStackLayout>

        <!-- CONTATO -->
        <Border x:Name="CardContato"
                WidthRequest="500"
                HeightRequest="120"
                StrokeShape="RoundRectangle 20"
                BackgroundColor="#222222"
                HorizontalOptions="Center">

            <Border.GestureRecognizers>
                <TapGestureRecognizer Tapped="TapContato"/>
            </Border.GestureRecognizers>

            <VerticalStackLayout VerticalOptions="Center"
                                 HorizontalOptions="Center">
                <Label Text="Contato por Email" TextColor="White"/>
                <Label Text="guilhermelopes_dev@hotmail.com"
                       TextColor="Gray"/>
            </VerticalStackLayout>

        </Border>

    </VerticalStackLayout>

</ContentPage>